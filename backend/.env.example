# Server
PORT=8080

# Timeout for fetching from upstream data sources (in seconds)
FETCH_TIMEOUT_SECONDS=45

# Per-IP request limit on /api/v1 (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Header the proxy in front of the API writes the client address into,
# overwriting any value a client sends. Empty: the TCP peer, with no proxy.
CLIENT_IP_HEADER=

# Comma-separated CORS origins; * allows all (public read-only API)
ALLOWED_ORIGINS=*

# User-Agent sent to api.weather.gov — NWS policy asks for identification
# with contact info. Forks should set their own.
NWS_USER_AGENT=SentryAtlas/1.0 (github.com/KOHANTIC/SentryAtlas)

# Email (off unless RESEND_API_KEY is set). The key is a secret: an encrypted
# variable in production, never committed. MAIL_SENDER=log prints messages,
# addresses included, instead of sending them: local runs only.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_SENDER=
