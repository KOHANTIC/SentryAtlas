  "scripts": {
    "tokens": "node ../brand/css.mjs > src/app/tokens.css && cp ../brand/logo/mark.svg public/icon.svg",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
