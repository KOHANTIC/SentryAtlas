    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
