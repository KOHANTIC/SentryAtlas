{
  "name": "sentryatlas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "node ../brand/css.mjs > src/app/tokens.css && cp ../brand/logo/mark.svg public/icon.svg && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/ && node scripts/types.mjs",
    "predev": "npm run gen",
    "dev": "next dev",
    "prebuild": "npm run gen",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
